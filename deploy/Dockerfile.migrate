# Applies the database migrations. It is a one-shot job: it runs, applies whatever is missing, and exits.
# It uses an EF Core "migrations bundle": one self-contained program, so the server needs neither the SDK nor the source.
#
# Built from the repository root:  docker build -f deploy/Dockerfile.migrate -t veilgate-migrate .
# Run it with VEILGATE_MIGRATOR_CONNECTION set to the vg_migrator connection string (the schema owner, never vg_app).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src
COPY .config ./.config
COPY Directory.Build.props global.json ./
COPY src ./src
RUN dotnet tool restore
RUN dotnet restore src/VeilGate.Api/VeilGate.Api.csproj
# The program must match the machine the image runs on (an Apple Silicon Mac builds arm64 images).
RUN RID=$( [ "$TARGETARCH" = "arm64" ] && echo linux-arm64 || echo linux-x64 ) \
 && dotnet ef migrations bundle --project src/VeilGate.Infrastructure --startup-project src/VeilGate.Api \
      --self-contained -r "$RID" --output /out/efbundle --force

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0 AS final
WORKDIR /app
COPY --from=build /out/efbundle .
# A single-file program unpacks native parts at start. The user's home folder does not exist in this image, so use /tmp.
ENV DOTNET_BUNDLE_EXTRACT_BASE_DIR=/tmp
USER app
ENTRYPOINT ["./efbundle"]
