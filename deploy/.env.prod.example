# What deploy/.env.prod contains. DO NOT fill this file in: run deploy/scripts/generate-secrets.sh, which writes
# deploy/.env.prod with strong random values. These placeholders exist so CI can check that the compose file is valid.
VG_DOMAIN=veilgate.example.com
ACME_EMAIL=ops@example.com

PG_ADMIN_PASSWORD=replace-me
PG_MIGRATOR_PASSWORD=replace-me
PG_APP_PASSWORD=replace-me
PG_READONLY_PASSWORD=replace-me

# 32 random bytes, base64
VAULT_KEK=replace-me
MFA_ENCRYPTION_KEY=replace-me

# An ES256 (P-256) private key on one line, newlines written as \n
JWT_KID=key-example
JWT_PRIVATE_KEY_PEM='-----BEGIN EC PRIVATE KEY-----\nreplace-me\n-----END EC PRIVATE KEY-----'

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USER=
SMTP_PASSWORD=

# Optional
# VG_VERSION=1.0.0                 which image tag to build and run (default: latest)
# CADDYFILE=./Caddyfile.local      to try the stack on your own computer (see that file)
